#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
ENV_EXAMPLE="$ROOT_DIR/.env.example"
BACKUP_TOOL="$ROOT_DIR/scripts/backup_manifest.py"
POSTGRES_COMPOSE_FILE="$ROOT_DIR/deploy/compose.postgresql.yml"
VOLUME_SPECS=(
  "data-ingestion:/app/data:data-ingestion-db.tgz"
  "quant-engine:/app/data:quant-engine-db.tgz"
  "portfolio-engine:/app/data:portfolio-db.tgz"
)

cd "$ROOT_DIR"

info() {
  printf '%s\n' "$*"
}

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

compose() {
  docker compose "$@"
}

postgres_compose() {
  docker compose \
    -f "$ROOT_DIR/docker-compose.yml" \
    -f "$POSTGRES_COMPOSE_FILE" \
    --profile migration \
    "$@"
}

validate_postgres_compose() {
  [[ -f "$POSTGRES_COMPOSE_FILE" ]] ||
    fail "PostgreSQL Compose overlay is missing."
  postgres_compose config --quiet
}

usage() {
  cat <<'EOF'
Market Analysis operator commands

Usage:
  ./manage <command> [options]

Commands:
  install   Create a secure .env, validate Compose, build, and start
  start     Start the application
  stop      Stop the application without deleting persistent data
  restart   Restart the application
  status    Show service status and the configured dashboard URL
  logs      Stream or print service logs
  backup    Stop services briefly and archive all persistent volumes
  verify-backup  Validate backup checksums, schemas, and record counts
  restore   Restore persistent volumes from a backup directory
  migrate   Create a verified backup and upgrade all database schemas
  migration-status  Show each database's current migration revision
  import-postgresql  Dry-run or apply the SQLite-to-PostgreSQL import
  postgres-backup  Create and verify a logical PostgreSQL backup
  postgres-restore-drill  Rehearse a backup in an isolated temporary database
  postgres-status  Report database growth and long-running queries
  postgres-maintain  Run allowlisted VACUUM (ANALYZE) maintenance
  postgres-retention  Report or apply backup-gated candle retention
  upgrade   Back up, fast-forward Git, rebuild, and verify
  verify    Validate Compose and service readiness
  help      Show this help

Run "./manage <command> --help" for command-specific options.
EOF
}

command_help() {
  case "$1" in
    install)
      cat <<'EOF'
Usage: ./manage install [--base-url URL] [--bind-address ADDRESS] [--enable-auth] [--no-start]

Creates .env from .env.example when needed, generates required secrets without
printing them, validates Docker Compose, and starts the application. Use a
remote-lab URL such as https://market.lab.example and an explicit bind address
when the dashboard is not accessed through localhost. Non-loopback bindings
require --enable-auth or an existing AUTH_ENABLED=true setting.
EOF
      ;;
    start)
      cat <<'EOF'
Usage: ./manage start [--build]

Starts all services and waits for their internal readiness endpoints.
EOF
      ;;
    stop)
      cat <<'EOF'
Usage: ./manage stop

Stops and removes application containers and networks. Named data volumes are
preserved. This command never passes --volumes.
EOF
      ;;
    restart)
      cat <<'EOF'
Usage: ./manage restart [--build]

Stops and starts the application, preserving named data volumes.
EOF
      ;;
    status)
      cat <<'EOF'
Usage: ./manage status

Prints Docker Compose service status and the configured public dashboard URL.
EOF
      ;;
    logs)
      cat <<'EOF'
Usage: ./manage logs [SERVICE] [--follow] [--tail LINES]

Prints logs for all services or one Compose service. Defaults to 200 lines.
EOF
      ;;
    backup)
      cat <<'EOF'
Usage: ./manage backup [DIRECTORY]

Briefly stops services, archives the three persistent named volumes, and then
restarts the previously running deployment. The default destination is a
timestamped directory under ./backups. The backup is verified before success.
EOF
      ;;
    verify-backup)
      cat <<'EOF'
Usage: ./manage verify-backup DIRECTORY

Validates archive checksums, safe extraction, SQLite integrity, schemas, file
inventories, and table record counts without changing application data.
EOF
      ;;
    restore)
      cat <<'EOF'
Usage: ./manage restore DIRECTORY [--no-start] [--project-name NAME] [--allow-legacy]

Stops the application, replaces all three persistent volumes from a backup
created by "./manage backup", and starts the restored deployment by default.
Use --project-name with --no-start to restore into an isolated Compose project.
Legacy backups without checksums require the explicit --allow-legacy override.
EOF
      ;;
    migrate)
      cat <<'EOF'
Usage: ./manage migrate [--backup-dir DIRECTORY]

Creates and verifies a backup, stops running services, upgrades every
service-owned database to its migration head, and restarts the prior
deployment. Services remain stopped if a migration fails.
EOF
      ;;
    migration-status)
      cat <<'EOF'
Usage: ./manage migration-status

Reports the current Alembic revision for data-ingestion, quant-engine, and
portfolio-engine, and fails if any database is not at its configured head.
EOF
      ;;
    import-postgresql)
      cat <<'EOF'
Usage: ./manage import-postgresql [--apply] [--backup-dir DIRECTORY]
       [--resume RUN_ID] [--accept-deferred STORE.TABLE]
       [--user-map FILE] [--report-dir DIRECTORY]

Runs a read-only dry run by default. It validates all three SQLite stores,
reports invalid rows and operator decisions, and writes no domain records.
--apply creates and verifies a backup, freezes the SQLite services, imports
into PostgreSQL, reconciles counts/keys/financial values, and leaves runtime
storage settings unchanged. Price alerts currently require the explicit
"--accept-deferred market.price_alerts" decision and are preserved in the
operations import ledger. No command in this workflow performs cutover.
EOF
      ;;
    postgres-backup)
      cat <<'EOF'
Usage: ./manage postgres-backup [DIRECTORY]

Creates a consistent custom-format pg_dump, records revisions and exact table
counts in a SHA-256 manifest, and verifies the archive. The default directory
is ./backups/postgresql-<UTC timestamp>.
EOF
      ;;
    postgres-restore-drill)
      cat <<'EOF'
Usage: ./manage postgres-restore-drill DIRECTORY

Verifies a logical backup, restores it into a randomly named isolated database,
reconciles migration revisions and table counts, then removes the drill database.
The active application database is never overwritten.
EOF
      ;;
    postgres-status)
      cat <<'EOF'
Usage: ./manage postgres-status

Reports database/table growth, dead tuples, vacuum/analyze timestamps,
queries running longer than five seconds, and partition-review thresholds.
EOF
      ;;
    postgres-maintain)
      cat <<'EOF'
Usage: ./manage postgres-maintain [--table SCHEMA.TABLE]...

Runs VACUUM (ANALYZE) on the allowlisted durable tables. With no --table
options, all current market, research, portfolio, order, and audit tables run.
EOF
      ;;
    postgres-retention)
      cat <<'EOF'
Usage: ./manage postgres-retention --as-of TIMESTAMP
       [--apply --archive-directory DIRECTORY] [--batch-size ROWS]

Dry-run is the default. Only eligible high-frequency candles are considered;
trade, order, fill, journal, live audit, and import evidence is never deleted.
Apply requires a verified logical PostgreSQL backup and deletes at most one
batch per policy, making each scheduled run bounded and reviewable.
EOF
      ;;
    upgrade)
      cat <<'EOF'
Usage: ./manage upgrade [--allow-backup-failure]

Requires a clean Git worktree. Creates a backup, fast-forwards the current
branch, rebuilds images, starts services, and verifies readiness. A failed
backup stops the upgrade unless --allow-backup-failure is explicitly supplied.
EOF
      ;;
    verify)
      cat <<'EOF'
Usage: ./manage verify [--config-only]

Validates the rendered Compose configuration. Unless --config-only is used,
also verifies every running service through its internal readiness endpoint.
EOF
      ;;
    *)
      fail "Unknown command '$1'. Run './manage help'."
      ;;
  esac
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "'$1' is required but was not found in PATH."
}

preflight() {
  require_command git
  require_command docker
  docker info >/dev/null 2>&1 || fail "Docker is installed but the daemon is unavailable. Start Docker Desktop or the Docker service."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required. Install a current Docker Desktop or Docker Engine Compose plugin."
}

require_env() {
  [[ -f "$ENV_FILE" ]] || fail ".env is missing. Run './manage install' first."
}

env_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE"
}

set_env_value() {
  local key="$1"
  local value="$2"
  local temp_file
  temp_file="$(mktemp "$ROOT_DIR/.env.XXXXXX")"
  awk -v key="$key" -v value="$value" '
    BEGIN { replaced = 0 }
    index($0, key "=") == 1 {
      print key "=" value
      replaced = 1
      next
    }
    { print }
    END {
      if (!replaced) {
        print key "=" value
      }
    }
  ' "$ENV_FILE" >"$temp_file"
  chmod 600 "$temp_file"
  mv "$temp_file" "$ENV_FILE"
}

validate_base_url() {
  [[ "$1" =~ ^https?://[^[:space:]]+$ ]] || fail "Base URL must begin with http:// or https:// and contain no spaces."
}

generate_missing_secrets() {
  local generated key value
  generated="$(docker run --rm python:3.12-slim python -c \
    "import base64, os, secrets; print('CREDENTIAL_ENCRYPTION_KEYS=' + base64.urlsafe_b64encode(os.urandom(32)).decode()); print('INTERNAL_SERVICE_TOKEN=' + secrets.token_urlsafe(32)); print('SETTINGS_OPERATOR_TOKEN=' + secrets.token_urlsafe(32)); print('JWT_SECRET=' + secrets.token_hex(32)); print('LIVE_OPERATOR_TOKEN=' + secrets.token_urlsafe(32))")" \
    || fail "Unable to generate deployment secrets with Docker."

  while IFS='=' read -r key value; do
    [[ -n "$key" && -n "$value" ]] || continue
    if [[ -z "$(env_value "$key")" ]]; then
      set_env_value "$key" "$value"
    fi
  done <<<"$generated"
}

prepare_env() {
  local base_url="$1"
  local bind_address="$2"
  local enable_auth="$3"

  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_EXAMPLE" ]] || fail ".env.example is missing."
    cp "$ENV_EXAMPLE" "$ENV_FILE"
  fi
  chmod 600 "$ENV_FILE"

  if [[ -n "$base_url" ]]; then
    validate_base_url "$base_url"
    set_env_value PUBLIC_BASE_URL "$base_url"
    set_env_value ALLOWED_ORIGINS "${base_url%/}"
  fi

  if [[ -n "$bind_address" ]]; then
    set_env_value HOST_BIND_ADDRESS "$bind_address"
  elif [[ -z "$(env_value HOST_BIND_ADDRESS)" ]]; then
    set_env_value HOST_BIND_ADDRESS "127.0.0.1"
  fi

  if [[ "$enable_auth" -eq 1 ]]; then
    set_env_value AUTH_ENABLED "true"
  fi

  generate_missing_secrets
  chmod 600 "$ENV_FILE"
}

validate_compose() {
  require_env
  local bind_address auth_enabled
  bind_address="$(env_value HOST_BIND_ADDRESS)"
  bind_address="${bind_address:-127.0.0.1}"
  auth_enabled="$(env_value AUTH_ENABLED)"
  if [[ "$bind_address" != "127.0.0.1" && "${auth_enabled,,}" != "true" ]]; then
    fail "AUTH_ENABLED=true is required when HOST_BIND_ADDRESS is not 127.0.0.1. Re-run install with --enable-auth."
  fi
  compose config --quiet || fail "Docker Compose configuration is invalid. Review the error above and .env."
}

service_ready() {
  local service="$1"
  if [[ "$service" == "frontend" ]]; then
    compose exec -T frontend wget -q -O /dev/null http://127.0.0.1/
  else
    compose exec -T "$service" python -c \
      "import httpx; httpx.get('http://localhost:${2}/health', timeout=5).raise_for_status()"
  fi
}

wait_for_services() {
  local attempt service failed
  info "Waiting for service readiness..."
  for ((attempt = 1; attempt <= 60; attempt++)); do
    failed=0
    service_ready portfolio-engine 8002 >/dev/null 2>&1 || failed=1
    service_ready data-ingestion 8000 >/dev/null 2>&1 || failed=1
    service_ready notification-gateway 8003 >/dev/null 2>&1 || failed=1
    service_ready quant-engine 8001 >/dev/null 2>&1 || failed=1
    service_ready frontend 80 >/dev/null 2>&1 || failed=1
    if [[ "$failed" -eq 0 ]]; then
      info "All services are ready."
      return
    fi
    sleep 2
  done
  compose ps >&2 || true
  fail "Services did not become ready within 120 seconds. Run './manage logs' for details."
}

public_url() {
  local configured
  configured="$(env_value PUBLIC_BASE_URL)"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
  else
    printf 'http://localhost:%s' "$(env_value FRONTEND_PORT)"
  fi
}

install_command() {
  local base_url=""
  local bind_address=""
  local enable_auth=0
  local no_start=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base-url)
        [[ $# -ge 2 ]] || fail "--base-url requires a value."
        base_url="$2"
        shift 2
        ;;
      --bind-address)
        [[ $# -ge 2 ]] || fail "--bind-address requires a value."
        bind_address="$2"
        shift 2
        ;;
      --no-start)
        no_start=1
        shift
        ;;
      --enable-auth)
        enable_auth=1
        shift
        ;;
      *)
        fail "Unknown install option '$1'. Run './manage install --help'."
        ;;
    esac
  done

  preflight
  prepare_env "$base_url" "$bind_address" "$enable_auth"
  validate_compose
  if [[ "$no_start" -eq 1 ]]; then
    info "Installation configuration is ready. Secrets were written to .env without being displayed."
    return
  fi
  compose build
  backup_command
  apply_migrations
  compose up -d
  wait_for_services
  info "Dashboard: $(public_url)"
}

start_command() {
  local build=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --build)
        build=1
        shift
        ;;
      *)
        fail "Unknown start option '$1'. Run './manage start --help'."
        ;;
    esac
  done
  preflight
  validate_compose
  if [[ "$build" -eq 1 ]]; then
    compose up --build -d
  else
    compose up -d
  fi
  wait_for_services
  info "Dashboard: $(public_url)"
}

stop_command() {
  preflight
  require_env
  compose down
  info "Application stopped. Persistent volumes were preserved."
}

status_command() {
  preflight
  require_env
  compose ps
  info "Dashboard: $(public_url)"
}

logs_command() {
  local service=""
  local follow=0
  local tail_lines=200
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f)
        follow=1
        shift
        ;;
      --tail)
        [[ $# -ge 2 ]] || fail "--tail requires a line count."
        tail_lines="$2"
        shift 2
        ;;
      -*)
        fail "Unknown logs option '$1'. Run './manage logs --help'."
        ;;
      *)
        [[ -z "$service" ]] || fail "Only one service may be specified."
        service="$1"
        shift
        ;;
    esac
  done
  preflight
  require_env
  local args=(logs --tail "$tail_lines")
  [[ "$follow" -eq 0 ]] || args+=(--follow)
  [[ -z "$service" ]] || args+=("$service")
  compose "${args[@]}"
}

volume_name() {
  local service="$1"
  local target="$2"
  local container_id
  container_id="$(compose ps -aq "$service" | head -n 1)"
  if [[ -z "$container_id" ]]; then
    compose up --no-start --no-deps "$service" >/dev/null
    container_id="$(compose ps -aq "$service" | head -n 1)"
  fi
  [[ -n "$container_id" ]] || fail "Unable to create or locate the $service container."
  docker inspect "$container_id" \
    --format "{{range .Mounts}}{{if eq .Destination \"$target\"}}{{.Name}}{{end}}{{end}}"
}

archive_volume() {
  local volume="$1"
  local backup_dir="$2"
  local filename="$3"
  docker run --rm \
    --volume "$volume:/source:ro" \
    python:3.12-slim \
    python -c "import sys, tarfile; archive=tarfile.open(fileobj=sys.stdout.buffer, mode='w|gz'); archive.add('/source', arcname='.'); archive.close()" \
    "$filename" \
    >"$backup_dir/$filename"
}

validate_archive() {
  local backup_dir="$1"
  local filename="$2"
  docker run --rm \
    --volume "$backup_dir:/backup:ro" \
    python:3.12-slim \
    python -c "import pathlib, sys, tarfile; archive=tarfile.open('/backup/' + sys.argv[1]); members=archive.getmembers(); invalid=[m.name for m in members if pathlib.PurePosixPath(m.name).is_absolute() or '..' in pathlib.PurePosixPath(m.name).parts or m.issym() or m.islnk() or m.isdev() or m.isfifo()]; invalid and sys.exit('unsafe archive member: ' + invalid[0]); [(lambda stream: [None for _ in iter(lambda: stream.read(1024 * 1024), b'')])(archive.extractfile(m)) for m in members if m.isfile()]; archive.close()" \
    "$filename"
}

extract_archive() {
  local volume="$1"
  local backup_dir="$2"
  local filename="$3"
  docker run --rm \
    --volume "$volume:/restore" \
    --volume "$backup_dir:/backup:ro" \
    python:3.12-slim \
    python -c "import pathlib, shutil, sys, tarfile; root=pathlib.Path('/restore'); [shutil.rmtree(item) if item.is_dir() else item.unlink() for item in root.iterdir()]; archive=tarfile.open('/backup/' + sys.argv[1]); archive.extractall('/restore', filter='data'); archive.close()" \
    "$filename"
}

copy_volume() {
  local source="$1"
  local destination="$2"
  docker run --rm \
    --volume "$source:/source:ro" \
    --volume "$destination:/destination" \
    python:3.12-slim \
    python -c "import pathlib, shutil; source=pathlib.Path('/source'); destination=pathlib.Path('/destination'); [shutil.rmtree(item) if item.is_dir() else item.unlink() for item in destination.iterdir()]; [shutil.copytree(item, destination / item.name, symlinks=False) if item.is_dir() else shutil.copy2(item, destination / item.name) for item in source.iterdir()]"
}

secure_backup_path() {
  local backup_dir="$1"
  chmod 700 "$backup_dir"
  find "$backup_dir" -type f -exec chmod 600 {} +
}

backup_tool() {
  local backup_dir="$1"
  shift
  [[ -f "$BACKUP_TOOL" ]] || fail "Backup metadata tool is missing: $BACKUP_TOOL"
  docker run --rm \
    --volume "$BACKUP_TOOL:/tool.py:ro" \
    --volume "$backup_dir:/backup:ro" \
    python:3.12-slim \
    python /tool.py "$@"
}

create_backup_manifest() {
  local backup_dir="$1"
  local git_commit app_version compose_project encryption_option
  git_commit="$(git rev-parse HEAD 2>/dev/null || printf unknown)"
  app_version="$(git describe --always --dirty --tags 2>/dev/null || printf '%s' "$git_commit")"
  compose_project="${COMPOSE_PROJECT_NAME:-$(basename "$ROOT_DIR")}"
  encryption_option="--no-encryption-key-configured"
  if [[ -n "$(env_value CREDENTIAL_ENCRYPTION_KEYS)" ]]; then
    encryption_option="--encryption-key-configured"
  fi
  backup_tool "$backup_dir" create \
    --backup-dir /backup \
    --git-commit "${git_commit:-unknown}" \
    --app-version "${app_version:-${git_commit:-unknown}}" \
    --compose-project "$compose_project" \
    "$encryption_option" \
    >"$backup_dir/manifest.json"
}

verify_backup_manifest() {
  local backup_dir="$1"
  backup_tool "$backup_dir" verify --backup-dir /backup
}

verify_restored_volume() {
  local volume="$1"
  local backup_dir="$2"
  local service="$3"
  docker run --rm \
    --volume "$BACKUP_TOOL:/tool.py:ro" \
    --volume "$backup_dir:/backup:ro" \
    --volume "$volume:/volume:ro" \
    python:3.12-slim \
    python /tool.py verify-volume \
      --backup-dir /backup \
      --volume-root /volume \
      --service "$service"
}

validate_project_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "Compose project name must use lowercase letters, digits, hyphens, or underscores."
}

restart_services() {
  [[ $# -eq 0 ]] || compose start "$@"
}

migration_command() {
  local service="$1"
  shift
  compose run --rm --no-deps "$service" alembic "$@"
}

apply_migrations() {
  local running_output service
  running_output="$(compose ps --services --status running)"
  local -a running_services=()
  if [[ -n "$running_output" ]]; then
    while IFS= read -r service; do
      [[ -z "$service" ]] || running_services+=("$service")
    done <<<"$running_output"
  fi
  [[ "${#running_services[@]}" -eq 0 ]] || compose stop "${running_services[@]}"
  migration_command data-ingestion upgrade head
  migration_command quant-engine upgrade head
  migration_command portfolio-engine upgrade head
  if [[ "${#running_services[@]}" -gt 0 ]]; then
    compose up -d
    wait_for_services
  fi
}

backup_command() {
  local backup_dir="${1:-$ROOT_DIR/backups/$(date -u +%Y%m%dT%H%M%SZ)}"
  [[ $# -le 1 ]] || fail "Usage: ./manage backup [DIRECTORY]"
  preflight
  validate_compose
  umask 077
  mkdir -p "$backup_dir"
  backup_dir="$(cd "$backup_dir" && pwd)"
  secure_backup_path "$backup_dir"

  local running_output
  running_output="$(compose ps --services --status running)"
  local -a running_services=()
  if [[ -n "$running_output" ]]; then
    while IFS= read -r service; do
      [[ -z "$service" ]] || running_services+=("$service")
    done <<<"$running_output"
  fi

  local spec service target filename volume
  local -a volumes=()
  for spec in "${VOLUME_SPECS[@]}"; do
    IFS=: read -r service target filename <<<"$spec"
    target="/${target#/}"
    volume="$(volume_name "$service" "$target")"
    [[ -n "$volume" ]] || fail "Unable to resolve the $service data volume."
    volumes+=("$volume")
  done

  local backup_needs_restart=1
  backup_on_error() {
    local status=$?
    trap - ERR
    if [[ "$backup_needs_restart" -eq 1 ]]; then
      restart_services "${running_services[@]}" >/dev/null 2>&1 || true
    fi
    printf 'Error: Backup failed. Previously running services were restarted when possible.\n' >&2
    exit "$status"
  }
  trap backup_on_error ERR

  [[ "${#running_services[@]}" -eq 0 ]] || compose stop "${running_services[@]}"
  local index
  for index in "${!VOLUME_SPECS[@]}"; do
    filename="${VOLUME_SPECS[$index]##*:}"
    archive_volume "${volumes[$index]}" "$backup_dir" "$filename"
  done
  create_backup_manifest "$backup_dir"
  verify_backup_manifest "$backup_dir"
  secure_backup_path "$backup_dir"

  restart_services "${running_services[@]}"
  backup_needs_restart=0
  trap - ERR
  info "Backup created and verified: $backup_dir"
  info "Encryption keys are not included. Retain CREDENTIAL_ENCRYPTION_KEYS separately."
}

verify_backup_command() {
  [[ $# -eq 1 ]] || fail "Usage: ./manage verify-backup DIRECTORY"
  local backup_dir="$1"
  [[ -d "$backup_dir" ]] || fail "Backup directory '$backup_dir' does not exist."
  backup_dir="$(cd "$backup_dir" && pwd)"
  preflight
  verify_backup_manifest "$backup_dir"
}

migrate_command() {
  local backup_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --backup-dir)
        [[ $# -ge 2 ]] || fail "--backup-dir requires a value."
        backup_dir="$2"
        shift 2
        ;;
      *)
        fail "Usage: ./manage migrate [--backup-dir DIRECTORY]"
        ;;
    esac
  done
  preflight
  validate_compose
  compose build data-ingestion quant-engine portfolio-engine
  if [[ -n "$backup_dir" ]]; then
    backup_command "$backup_dir"
  else
    backup_command
  fi
  apply_migrations
  info "Database migrations are at head."
}

migration_status_command() {
  [[ $# -eq 0 ]] || fail "Usage: ./manage migration-status"
  preflight
  validate_compose
  migration_command data-ingestion current --check-heads
  migration_command quant-engine current --check-heads
  migration_command portfolio-engine current --check-heads
}

wait_for_postgresql() {
  local attempt
  for ((attempt = 1; attempt <= 60; attempt++)); do
    if postgres_compose exec -T postgresql \
      pg_isready \
      -U "${MARKET_DATA_POSTGRES_USER:-market_analysis}" \
      -d "${MARKET_DATA_POSTGRES_DB:-market_analysis}" \
      >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done
  fail "PostgreSQL did not become ready within 60 seconds."
}

postgres_migration_command() {
  local service="$1"
  shift
  postgres_compose run --rm --no-deps "$service" alembic "$@"
}

import_postgresql_command() {
  local apply=0
  local backup_dir=""
  local resume_run=""
  local user_map_file=""
  local report_dir=""
  local -a accepted_deferred=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply)
        apply=1
        shift
        ;;
      --backup-dir)
        [[ $# -ge 2 ]] || fail "--backup-dir requires a value."
        backup_dir="$2"
        shift 2
        ;;
      --resume)
        [[ $# -ge 2 ]] || fail "--resume requires an import run ID."
        resume_run="$2"
        shift 2
        ;;
      --accept-deferred)
        [[ $# -ge 2 ]] || fail "--accept-deferred requires STORE.TABLE."
        accepted_deferred+=("$2")
        shift 2
        ;;
      --user-map)
        [[ $# -ge 2 ]] || fail "--user-map requires a JSON file."
        user_map_file="$2"
        shift 2
        ;;
      --report-dir)
        [[ $# -ge 2 ]] || fail "--report-dir requires a directory."
        report_dir="$2"
        shift 2
        ;;
      *)
        fail "Unknown import-postgresql option '$1'."
        ;;
    esac
  done
  [[ "$apply" -eq 1 || -z "$resume_run" ]] \
    || fail "--resume requires --apply."
  [[ -z "$user_map_file" || -f "$user_map_file" ]] \
    || fail "User mapping file '$user_map_file' does not exist."

  preflight
  validate_compose
  [[ -f "$POSTGRES_COMPOSE_FILE" ]] \
    || fail "PostgreSQL Compose overlay is missing."
  migration_command data-ingestion current --check-heads
  migration_command quant-engine current --check-heads
  migration_command portfolio-engine current --check-heads

  local timestamp manifest_path=""
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  report_dir="${report_dir:-$ROOT_DIR/migration-reports/$timestamp}"
  mkdir -p "$report_dir"
  report_dir="$(cd "$report_dir" && pwd)"
  chmod 700 "$report_dir"
  if [[ "$apply" -eq 1 ]]; then
    backup_dir="${backup_dir:-$ROOT_DIR/backups/postgresql-import-$timestamp}"
    backup_command "$backup_dir"
    backup_dir="$(cd "$backup_dir" && pwd)"
    manifest_path="$backup_dir/manifest.json"
    [[ -f "$manifest_path" ]] || fail "Verified backup manifest is missing."
  fi

  local running_output service
  running_output="$(compose ps --services --status running)"
  local -a running_services=()
  if [[ -n "$running_output" ]]; then
    while IFS= read -r service; do
      [[ -z "$service" ]] || running_services+=("$service")
    done <<<"$running_output"
  fi
  [[ "${#running_services[@]}" -eq 0 ]] \
    || compose stop "${running_services[@]}"

  import_on_error() {
    local status=$?
    trap - ERR
    restart_services "${running_services[@]}" >/dev/null 2>&1 || true
    printf 'Error: PostgreSQL import setup failed. SQLite services were restarted when possible.\n' >&2
    exit "$status"
  }
  trap import_on_error ERR

  postgres_compose build \
    data-ingestion quant-engine portfolio-engine migration-runner
  postgres_compose up -d postgresql
  wait_for_postgresql
  postgres_migration_command data-ingestion upgrade head
  postgres_migration_command quant-engine upgrade head
  postgres_migration_command portfolio-engine upgrade head

  local -a runner_args=(
    --market-sqlite /sources/market/data_ingestion.db
    --research-sqlite /sources/research/backtests.db
    --portfolio-sqlite /sources/portfolio/portfolio.db
    --research-source-root /sources/research
    --research-target-artifact-root /target/research-artifacts
    --research-runtime-artifact-root /app/artifacts
    --operator-id "${USER:-local-operator}"
  )
  if [[ "$apply" -eq 1 ]]; then
    runner_args+=(--apply --verified-backup-manifest /backup/manifest.json)
    [[ -z "$resume_run" ]] || runner_args+=(--resume "$resume_run")
  else
    runner_args+=(--dry-run)
  fi
  local decision
  for decision in "${accepted_deferred[@]}"; do
    runner_args+=(--accept-deferred "$decision")
  done
  if [[ -n "$user_map_file" ]]; then
    runner_args+=(--user-map "$(cat "$user_map_file")")
  fi

  local -a volume_args=()
  if [[ "$apply" -eq 1 ]]; then
    volume_args+=(--volume "$backup_dir:/backup:ro")
  fi
  set +e
  postgres_compose run --rm "${volume_args[@]}" \
    migration-runner "${runner_args[@]}" \
    >"$report_dir/import-report.json"
  local import_status=$?
  set -e

  restart_services "${running_services[@]}"
  trap - ERR
  chmod 600 "$report_dir/import-report.json"
  if [[ "$import_status" -ne 0 ]]; then
    fail "Import validation failed. Review $report_dir/import-report.json. SQLite remains active and PostgreSQL cutover is blocked."
  fi
  if [[ "$apply" -eq 1 ]]; then
    info "PostgreSQL import reconciled: $report_dir/import-report.json"
    info "Runtime storage remains on SQLite. Cutover was not performed."
  else
    info "PostgreSQL import dry run passed: $report_dir/import-report.json"
  fi
}

prepare_postgresql_operations() {
  require_env
  validate_postgres_compose
  postgres_compose build postgresql-operations
  postgres_compose up -d postgresql
  wait_for_postgresql
}

postgres_operations_run() {
  postgres_compose run --rm --no-deps \
    postgresql-operations "$@"
}

postgres_backup_command() {
  [[ $# -le 1 ]] || fail "Usage: ./manage postgres-backup [DIRECTORY]"
  local directory="${1:-$ROOT_DIR/backups/postgresql-$(date -u +%Y%m%dT%H%M%SZ)}"
  mkdir -p "$directory"
  directory="$(cd "$directory" && pwd)"
  chmod 700 "$directory"
  prepare_postgresql_operations
  postgres_compose run --rm --no-deps \
    --user "$(id -u):$(id -g)" \
    --volume "$directory:/backup" \
    postgresql-operations backup --directory /backup
  find "$directory" -type f -exec chmod 600 {} +
  info "PostgreSQL backup created and verified: $directory"
}

postgres_restore_drill_command() {
  [[ $# -eq 1 ]] || fail "Usage: ./manage postgres-restore-drill DIRECTORY"
  local directory="$1"
  [[ -d "$directory" ]] || fail "Backup directory '$directory' does not exist."
  directory="$(cd "$directory" && pwd)"
  prepare_postgresql_operations
  postgres_compose run --rm --no-deps \
    --volume "$directory:/backup:ro" \
    postgresql-operations restore-drill --directory /backup
}

postgres_status_command() {
  [[ $# -eq 0 ]] || fail "Usage: ./manage postgres-status"
  prepare_postgresql_operations
  postgres_operations_run status
}

postgres_maintain_command() {
  prepare_postgresql_operations
  local -a arguments=(maintain)
  while [[ $# -gt 0 ]]; do
    [[ "$1" == "--table" && $# -ge 2 ]] ||
      fail "Usage: ./manage postgres-maintain [--table SCHEMA.TABLE]..."
    arguments+=(--table "$2")
    shift 2
  done
  postgres_operations_run "${arguments[@]}"
}

postgres_retention_command() {
  local archive_directory=""
  local -a arguments=(retention)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --as-of|--batch-size)
        [[ $# -ge 2 ]] || fail "$1 requires a value."
        arguments+=("$1" "$2")
        shift 2
        ;;
      --apply)
        arguments+=(--apply)
        shift
        ;;
      --archive-directory)
        [[ $# -ge 2 ]] || fail "--archive-directory requires a value."
        archive_directory="$2"
        arguments+=(--archive-directory /archive)
        shift 2
        ;;
      *)
        fail "Unknown postgres-retention option '$1'."
        ;;
    esac
  done
  [[ " ${arguments[*]} " == *" --as-of "* ]] ||
    fail "--as-of is required."
  prepare_postgresql_operations
  if [[ -n "$archive_directory" ]]; then
    [[ -d "$archive_directory" ]] ||
      fail "Archive directory '$archive_directory' does not exist."
    archive_directory="$(cd "$archive_directory" && pwd)"
    postgres_compose run --rm --no-deps \
      --volume "$archive_directory:/archive:ro" \
      postgresql-operations "${arguments[@]}"
  else
    postgres_operations_run "${arguments[@]}"
  fi
}

restore_command() {
  [[ $# -ge 1 ]] || fail "Usage: ./manage restore DIRECTORY [--no-start]"
  local backup_dir="$1"
  local no_start=0
  local allow_legacy=0
  local project_name=""
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-start)
        no_start=1
        shift
        ;;
      --project-name)
        [[ $# -ge 2 ]] || fail "--project-name requires a value."
        project_name="$2"
        shift 2
        ;;
      --allow-legacy)
        allow_legacy=1
        shift
        ;;
      *)
        fail "Usage: ./manage restore DIRECTORY [--no-start] [--project-name NAME] [--allow-legacy]"
        ;;
    esac
  done
  [[ -d "$backup_dir" ]] || fail "Backup directory '$backup_dir' does not exist."
  backup_dir="$(cd "$backup_dir" && pwd)"
  if [[ -n "$project_name" ]]; then
    local source_project
    source_project="${COMPOSE_PROJECT_NAME:-$(env_value COMPOSE_PROJECT_NAME)}"
    source_project="${source_project:-$(basename "$ROOT_DIR")}"
    validate_project_name "$project_name"
    [[ "$project_name" != "$source_project" ]] || fail "--project-name must differ from the active Compose project '$source_project'."
    [[ "$no_start" -eq 1 ]] || fail "--project-name requires --no-start so isolated restores cannot conflict with the running deployment."
    export COMPOSE_PROJECT_NAME="$project_name"
  fi

  preflight
  validate_compose
  local verified_manifest=0
  if [[ -f "$backup_dir/manifest.json" ]]; then
    verify_backup_manifest "$backup_dir"
    verified_manifest=1
  elif [[ "$allow_legacy" -eq 1 ]]; then
    info "Warning: restoring a legacy backup without checksum or record-count reconciliation."
  else
    fail "Backup is missing manifest.json. Use --allow-legacy only for a trusted older backup."
  fi
  local spec filename
  for spec in "${VOLUME_SPECS[@]}"; do
    filename="${spec##*:}"
    [[ -f "$backup_dir/$filename" ]] || fail "Backup is incomplete: missing $filename."
    validate_archive "$backup_dir" "$filename"
  done

  local running_output service target volume index
  running_output="$(compose ps --services --status running)"
  local -a running_services=()
  if [[ -n "$running_output" ]]; then
    while IFS= read -r service; do
      [[ -z "$service" ]] || running_services+=("$service")
    done <<<"$running_output"
  fi

  local restore_id
  restore_id="market-analysis-restore-$(date -u +%Y%m%d%H%M%S)-$$"
  local -a live_volumes=()
  local -a stage_volumes=()
  local -a rollback_volumes=()
  local rollback_ready_count=0
  local restore_stopped=0

  restore_on_error() {
    local status=$?
    trap - ERR
    if [[ "$restore_stopped" -eq 1 ]]; then
      for ((index = 0; index < rollback_ready_count; index++)); do
        copy_volume "${rollback_volumes[$index]}" "${live_volumes[$index]}" >/dev/null 2>&1 || true
      done
      restart_services "${running_services[@]}" >/dev/null 2>&1 || true
    fi
    for volume in "${stage_volumes[@]}" "${rollback_volumes[@]}"; do
      [[ -z "$volume" ]] || docker volume rm -f "$volume" >/dev/null 2>&1 || true
    done
    printf 'Error: Restore failed. Original data and service state were recovered when possible.\n' >&2
    exit "$status"
  }
  trap restore_on_error ERR

  for index in "${!VOLUME_SPECS[@]}"; do
    spec="${VOLUME_SPECS[$index]}"
    IFS=: read -r service target filename <<<"$spec"
    target="/${target#/}"
    volume="$(volume_name "$service" "$target")"
    [[ -n "$volume" ]] || fail "Unable to resolve the $service data volume."
    live_volumes+=("$volume")
    volume="${restore_id}-${index}-stage"
    docker volume create "$volume" >/dev/null
    stage_volumes+=("$volume")
    extract_archive "$volume" "$backup_dir" "$filename"
    if [[ "$verified_manifest" -eq 1 ]]; then
      verify_restored_volume "$volume" "$backup_dir" "$service"
    fi
    volume="${restore_id}-${index}-rollback"
    docker volume create "$volume" >/dev/null
    rollback_volumes+=("$volume")
  done

  [[ "${#running_services[@]}" -eq 0 ]] || compose stop "${running_services[@]}"
  restore_stopped=1
  for index in "${!live_volumes[@]}"; do
    copy_volume "${live_volumes[$index]}" "${rollback_volumes[$index]}"
    rollback_ready_count=$((rollback_ready_count + 1))
  done
  for index in "${!live_volumes[@]}"; do
    copy_volume "${stage_volumes[$index]}" "${live_volumes[$index]}"
  done

  trap - ERR
  for volume in "${stage_volumes[@]}" "${rollback_volumes[@]}"; do
    docker volume rm -f "$volume" >/dev/null 2>&1 || true
  done

  if [[ "$no_start" -eq 1 ]]; then
    if [[ -n "$project_name" ]]; then
      info "Backup restored into isolated Compose project '$project_name'. Services remain stopped."
    else
      info "Backup restored. Services remain stopped."
    fi
    return
  fi
  compose up -d
  wait_for_services
  info "Backup restored and verified."
}

upgrade_command() {
  local allow_backup_failure=0
  if [[ "${1:-}" == "--allow-backup-failure" ]]; then
    allow_backup_failure=1
    shift
  fi
  [[ $# -eq 0 ]] || fail "Usage: ./manage upgrade [--allow-backup-failure]"
  preflight
  validate_compose
  [[ -z "$(git status --porcelain)" ]] || fail "Git worktree has local changes. Commit or move them before upgrading."
  if ! "$ROOT_DIR/manage" backup; then
    if [[ "$allow_backup_failure" -eq 0 ]]; then
      fail "Upgrade stopped because the pre-upgrade backup failed."
    fi
    info "Warning: continuing upgrade after backup failure by explicit operator override."
  fi
  git pull --ff-only
  compose build --pull
  apply_migrations
  compose up -d
  wait_for_services
  info "Upgrade completed. Dashboard: $(public_url)"
}

verify_command() {
  local config_only=0
  if [[ "${1:-}" == "--config-only" ]]; then
    config_only=1
    shift
  fi
  [[ $# -eq 0 ]] || fail "Usage: ./manage verify [--config-only]"
  preflight
  validate_compose
  if [[ "$config_only" -eq 0 ]]; then
    wait_for_services
  fi
  info "Verification passed."
}

main() {
  local command="${1:-help}"
  [[ $# -eq 0 ]] || shift
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    command_help "$command"
    return
  fi

  case "$command" in
    help|--help|-h)
      usage
      ;;
    install)
      install_command "$@"
      ;;
    start)
      start_command "$@"
      ;;
    stop)
      [[ $# -eq 0 ]] || fail "Usage: ./manage stop"
      stop_command
      ;;
    restart)
      stop_command
      start_command "$@"
      ;;
    status)
      [[ $# -eq 0 ]] || fail "Usage: ./manage status"
      status_command
      ;;
    logs)
      logs_command "$@"
      ;;
    backup)
      backup_command "$@"
      ;;
    verify-backup)
      verify_backup_command "$@"
      ;;
    restore)
      restore_command "$@"
      ;;
    migrate)
      migrate_command "$@"
      ;;
    migration-status)
      migration_status_command "$@"
      ;;
    import-postgresql)
      import_postgresql_command "$@"
      ;;
    postgres-backup)
      postgres_backup_command "$@"
      ;;
    postgres-restore-drill)
      postgres_restore_drill_command "$@"
      ;;
    postgres-status)
      postgres_status_command "$@"
      ;;
    postgres-maintain)
      postgres_maintain_command "$@"
      ;;
    postgres-retention)
      postgres_retention_command "$@"
      ;;
    upgrade)
      upgrade_command "$@"
      ;;
    verify)
      verify_command "$@"
      ;;
    *)
      fail "Unknown command '$command'. Run './manage help'."
      ;;
  esac
}

main "$@"
