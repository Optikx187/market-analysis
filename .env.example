# ══════════════════════════════════════════════════════════════
# Market Analysis — Microservices Configuration
# Copy this file to .env and fill in your credentials
# ══════════════════════════════════════════════════════════════

# ── Market Data APIs (Service A) ──
BINANCE_API_KEY=
BINANCE_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Notifications (Notification Gateway) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_TELEGRAM_ENABLED=true
NOTIFY_DISCORD_ENABLED=true

# ── Risk Parameters (Service B) ──
RISK_REWARD_RATIO=3.0
ATR_STOP_MULTIPLIER=1.5
ATR_VOLATILITY_THRESHOLD=2.0
TRAILING_STOP_PCT=0.02

# ── Portfolio (Service C) ──
INITIAL_BALANCE=10000.0
LOSS_TOLERANCE_PCT=0.02
MAX_PORTFOLIO_HEAT_PCT=0.08
MAX_TICKER_EXPOSURE_PCT=0.20
MAX_SECTOR_EXPOSURE_PCT=0.35
MAX_ASSET_CLASS_EXPOSURE_PCT=0.70
MAX_DIRECTIONAL_EXPOSURE_PCT=0.80
MAX_CORRELATED_EXPOSURE_PCT=0.40
CORRELATION_THRESHOLD=0.75
DAILY_LOSS_LIMIT_PCT=0.03
WEEKLY_LOSS_LIMIT_PCT=0.06
MAX_DRAWDOWN_PCT=0.12
VOLATILITY_TARGET_PCT=0.15
FRACTIONAL_KELLY_CAP=0.10
EQUITY_SHOCK_PCT=0.05
CRYPTO_SHOCK_PCT=0.20

# ── Guarded Live Broker Execution (Service C) ──
# Live trading stays impossible until this is true AND an operator posts the
# exact acknowledgement phrase to /api/live-trading/acknowledge.
LIVE_TRADING_ENABLED=false
LIVE_BROKER=alpaca
# Default endpoint is the Alpaca paper/sandbox host. Never point this at a
# production endpoint unless you intend to trade real money.
LIVE_BROKER_BASE_URL=https://paper-api.alpaca.markets
LIVE_ACK_PHRASE=ENABLE LIVE TRADING
LIVE_MAX_ORDER_NOTIONAL_USD=1000.0
LIVE_MAX_PRICE_AGE_SECONDS=300.0
ALPACA_SECRET_KEY=

# ── Internal Service URLs (set automatically by docker-compose) ──
# DATA_INGESTION_URL=http://data-ingestion:8000
# QUANT_ENGINE_URL=http://quant-engine:8001
