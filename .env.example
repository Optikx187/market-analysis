# ══════════════════════════════════════════════════════════════
# Market Analysis — Microservices Configuration
# Copy this file to .env and configure deployment settings
# ══════════════════════════════════════════════════════════════

# ── One-time provider credential migration ──
# Prefer Settings → Credentials. Values entered here are migrated into the
# encrypted database and removed from .env when portfolio-engine starts.
BINANCE_API_KEY=
BINANCE_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Notifications (Notification Gateway) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=

# Notification transport settings (non-secret)
SMTP_PORT=587
NOTIFY_TELEGRAM_ENABLED=true
NOTIFY_DISCORD_ENABLED=true
NOTIFY_SLACK_ENABLED=true
NOTIFY_EMAIL_ENABLED=true
NOTIFY_SMS_ENABLED=true

# ── Host ports ──
# Override these when running multiple Compose projects on one host.
# PUBLIC_BASE_URL is printed by the management commands for local or remote use.
# HOST_BIND_ADDRESS controls which host interface publishes Compose ports.
PUBLIC_BASE_URL=http://localhost:3000
HOST_BIND_ADDRESS=0.0.0.0
DATA_INGESTION_PORT=8000
QUANT_ENGINE_PORT=8001
PORTFOLIO_ENGINE_PORT=8002
NOTIFICATION_GATEWAY_PORT=8003
FRONTEND_PORT=3000

# ── Risk Parameters (Service B) ──
RISK_REWARD_RATIO=3.0
ATR_STOP_MULTIPLIER=1.5
ATR_VOLATILITY_THRESHOLD=2.0
TRAILING_STOP_PCT=0.02

# ── Portfolio (Service C) ──
# Required for encrypted credential storage and internal service retrieval.
# Supply both through your deployment secret manager in production. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS=
# openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Required for credential and risk-setting administration. Send only as
# X-Settings-Operator-Token; the frontend keeps it in memory and never persists it.
SETTINGS_OPERATOR_TOKEN=
INITIAL_BALANCE=10000.0
LOSS_TOLERANCE_PCT=0.02
MAX_PORTFOLIO_HEAT_PCT=0.08
MAX_TICKER_EXPOSURE_PCT=0.20
MAX_SECTOR_EXPOSURE_PCT=0.35
MAX_ASSET_CLASS_EXPOSURE_PCT=0.70
MAX_DIRECTIONAL_EXPOSURE_PCT=0.80
MAX_CORRELATED_EXPOSURE_PCT=0.40
CORRELATION_THRESHOLD=0.75
DAILY_LOSS_LIMIT_PCT=0.03
WEEKLY_LOSS_LIMIT_PCT=0.06
MAX_DRAWDOWN_PCT=0.12
VOLATILITY_TARGET_PCT=0.15
FRACTIONAL_KELLY_CAP=0.10
EQUITY_SHOCK_PCT=0.05
CRYPTO_SHOCK_PCT=0.20

# ── Optional Multi-User Authentication (Service C) ──
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true. Generate at least 32 random bytes, for example:
# openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Guarded Live Broker Execution (Service C) ──
# Live trading stays impossible until this is true AND an operator posts the
# exact acknowledgement phrase to /api/live-trading/acknowledge.
LIVE_TRADING_ENABLED=false
LIVE_BROKER=alpaca
# Default endpoint is the Alpaca paper/sandbox host. Never point this at a
# production endpoint unless you intend to trade real money.
LIVE_BROKER_BASE_URL=https://paper-api.alpaca.markets
LIVE_ACK_PHRASE=ENABLE LIVE TRADING
# Required independently of optional application auth. Send only as
# X-Live-Operator-Token; the frontend keeps it in memory and never persists it.
LIVE_OPERATOR_TOKEN=
LIVE_MAX_ORDER_NOTIONAL_USD=1000.0
LIVE_MAX_PRICE_AGE_SECONDS=300.0

# ── Internal Service URLs (set automatically by docker-compose) ──
# DATA_INGESTION_URL=http://data-ingestion:8000
# QUANT_ENGINE_URL=http://quant-engine:8001
